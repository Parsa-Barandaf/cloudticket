# Postgres connection string. On Runflare this is the managed Postgres "remote" URL,
# e.g. postgresql://pguser:pgpass@psql-xxxx.runflare.example:5432/cmp_crm?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT signing secret - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Token lifetime
JWT_EXPIRATION="7d"

# Backend HTTP port (container port)
PORT=4000

# Optional: comma-separated allowed origins for CORS.
# Leave unset to allow all origins (needed when the frontend is served by this same app).
# CORS_ORIGIN="https://app.example.com"

# Optional: set to "true" on first deploy to load demo/seed data (admin@example.com / 123456)
# RUN_SEED="true"