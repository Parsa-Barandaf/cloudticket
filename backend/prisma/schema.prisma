generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  CUSTOMER
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  INVESTIGATING
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CustomerTier {
  GOLD
  SILVER
  BRONZE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model Department {
  id               String   @id @default(cuid())
  name             String
  lead             String
  icon             String   @default("Users2")
  color            String   @default("indigo")
  assignedProducts String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users User[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(ADMIN)
  avatar    String?
  active    Boolean  @default(true)
  phone      String?
  company    String?
  isCustomer Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignedTickets Ticket[] @relation("AssignedAgent")

  customerId String?
  customer   Customer? @relation("CustomerEmployees", fields: [customerId], references: [id], onDelete: Cascade)
  customerProfile Customer? @relation("CustomerOwner")

  userRoles UserRoleAssignment[]
}

model Customer {
  id                    String       @id @default(cuid())
  commercialName        String?
  industry              String
  phone                 String?
  website               String?
  address               String?
  tier                  CustomerTier @default(BRONZE)
  status                CustomerStatus @default(ACTIVE)
  partnershipStartDate  DateTime?
  lastActivity          DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  userId String  @unique
  user   User    @relation("CustomerOwner", fields: [userId], references: [id])

  employees User[] @relation("CustomerEmployees")

  tickets     Ticket[]
  connections ProductCustomerConnection[]
}

model Product {
  id           String        @id @default(cuid())
  name         String
  category     String
  description  String?
  version      String        @default("v1.0.0")
  status       ProductStatus @default(ACTIVE)
  clientsCount Int           @default(0)
  logoColor    String?
  logoInitials String?
  createdAt    DateTime      @default(now())
  lastUpdated  DateTime      @updatedAt

  tickets     Ticket[]
  connections ProductCustomerConnection[]
}

model ProductCustomerConnection {
  id               String   @id @default(cuid())
  startDate        DateTime
  endDate          DateTime
  licenseStatus    String   @default("ACTIVE")
  userCount        Int      @default(0)
  activationKey    String
  notes            String?
  subscriptionType String
  createdAt        DateTime @default(now())

  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Ticket {
  id         String         @id @default(cuid())
  ticketNumber Int          @default(autoincrement())
  title      String
  priority   TicketPriority @default(MEDIUM)
  status     TicketStatus   @default(OPEN)
  date       DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedAgent", fields: [assignedToId], references: [id])

  messages         TicketMessage[]
  ticketAttachments TicketAttachment[]
}

model TicketMessage {
  id         String   @id @default(cuid())
  text       String
  senderName String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  authorId   String?
  authorType String?  // 'customer' | 'agent'

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketAttachment {
  id         String   @id @default(cuid())
  fileName   String
  fileKey    String
  mimeType   String?
  sizeBytes  BigInt?
  uploadedAt DateTime @default(now())

  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  title     String
  subtitle  String
  createdAt DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String
  priority        String   @default("normal")
  read            Boolean  @default(false)
  archived        Boolean  @default(false)
  authorName      String?
  authorAvatarBg  String?
  detailedContent String?
  linkedType      String?
  linkedId        String?
  linkedName      String?
  createdAt       DateTime @default(now())
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccessRequest {
  id          String              @id @default(cuid())
  name        String
  companyName String
  email       String
  phone       String
  industry    String?
  status      AccessRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Portal {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  createdAt   DateTime     @default(now())
  permissions Permission[]
  roles       RolePortal[]
}

model Permission {
  id        String   @id @default(cuid())
  key       String
  module    String
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id])
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([key, portalId])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  isEditable  Boolean  @default(true)
  isSystem    Boolean  @default(false)
  scope       String   @default("internal")
  orgId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]
  portals         RolePortal[]
}

model RolePortal {
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  portalId String
  portal   Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@id([roleId, portalId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, userId])
}
